# TEMPLATE ONLY. Real credentials belong in the existing ignored .env, never this example.
# Deploy the same file to /etc/aitalks/production.env on the VM (mode 0600).
# .env is excluded from Git/Docker build contexts; keep its permissions at 0600.
COMPOSE_PROJECT_NAME=aitalks
APP_ENV=production
APP_ORIGIN=https://aitalks.tech
SITE_ADDRESS=aitalks.tech
WWW_ADDRESS=www.aitalks.tech
DEMO_MODE=false

# Bootstrap only: imported into SQLite once. Then manage access/roles in the admin UI.
# Comma-separated exact primary Yandex account email addresses, lowercase.
ALLOWED_EMAILS=vgarshin@yandex.ru
ADMIN_EMAILS=vgarshin@yandex.ru

# Register a Yandex ID web login application with login:email and login:info.
# Exact callback: https://aitalks.tech/api/auth/callback
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=

# Service account credentials, separate from the Yandex ID OAuth app.
YANDEX_CLOUD_FOLDER_ID=
YANDEX_AI_API_KEY_ID=
YANDEX_AI_API_KEY=
YANDEX_SPEECHKIT_API_KEY_ID=
YANDEX_SPEECHKIT_API_KEY=

# Application caps use conservative reservations, NOT actual provider billing.
DAILY_LIMIT_RUB=500
MONTHLY_LIMIT_RUB=5000
# Review these against CURRENT tariffs and config/app.json bounds before enabling.
LLM_RESERVE_RUB=10
STT_RESERVE_RUB=5
# Per <=240-character TTS utterance; full-response reserve multiplies by utterances.
TTS_RESERVE_RUB=20
PROVIDER_BUDGET_REVIEWED=false

# Backups share this environment file with the application.
# Compose explicitly passes only application variables to its containers.
APP_DIRECTORY=/opt/aitalks/app
BACKUP_DIRECTORY=/var/backups/aitalks
BACKUP_LOCAL_ONLY=true
BACKUP_S3_BUCKET=aitalks-data
BACKUP_S3_ENDPOINT=https://storage.yandexcloud.net
BACKUP_S3_PREFIX=aitalks/backups
AWS_DEFAULT_REGION=ru-central1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_EC2_METADATA_DISABLED=true
# Keep the bucket private; backup credentials need upload/download/list/rotation access.

# Shared knowledge bases: local FAISS + SQLite; private originals use S3 settings above.
RAG_ENABLED=false
RAG_DOC_MODEL=text-search-doc/latest
RAG_QUERY_MODEL=text-search-query/latest
RAG_MIN_SCORE=0.2
EMBEDDING_RESERVE_RUB=0.1

# Dedicated Yandex Search API credentials.
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_API_KEY_ID=

# Web search uses result snippets plus bounded public-page text; enable with verified credentials.
WEB_SEARCH_ENABLED=false
SEARCH_RESERVE_RUB=10
SEARCH_CACHE_TTL_SECONDS=600

# Public-page extraction from up to two search results; no additional provider API fee.
WEB_PAGE_FETCH_ENABLED=true
WEB_PAGE_CACHE_TTL_SECONDS=600
