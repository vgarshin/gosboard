# Credential-free VM preview, accessible only through an SSH tunnel.
# ssh -L 18080:127.0.0.1:80 aitalks-test-01; open http://localhost:18080
COMPOSE_PROJECT_NAME=aitalks-demo
APP_ENV=development
APP_ORIGIN=http://localhost:18080
SITE_ADDRESS=http://localhost
DEMO_MODE=true
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
